# =============================================
# SmartRail Environment Configuration Template (Backend)
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to git!

# ── App ──────────────────────────────────────
APP_NAME=SmartRail
APP_VERSION=1.0.0
DEBUG=true

# ── Database (Supabase / PostgreSQL) ───────────
#
# Option A: Supabase (Cloud PostgreSQL) - RECOMMENDED
# Get your connection string from: Supabase Dashboard -> Project Settings -> Database
# 
# 1) Session Pooler (port 5432) - Best for migrations, table creation & seeding:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# 2) Transaction Pooler (port 6543) - Best for production API requests:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Replace [PROJECT-REF] and [YOUR-PASSWORD] with your actual Supabase credentials below:
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres
# Sync URL (optional - automatically derived from DATABASE_URL if omitted):
DATABASE_URL_SYNC=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# Option B: Local PostgreSQL (Docker) - uncomment below if running locally without Supabase
# POSTGRES_USER=smartrail
# POSTGRES_PASSWORD=smartrail_secret_2026
# POSTGRES_DB=smartrail
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://smartrail:smartrail_secret_2026@localhost:5432/smartrail
# DATABASE_URL_SYNC=postgresql://smartrail:smartrail_secret_2026@localhost:5432/smartrail

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── ML Models ────────────────────────────────
ML_ENABLED=true
ML_MODEL_DIR=app/ml/models

# ── LLM (Ollama - Local) ────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
LLM_ENABLED=false

# ── Journey Search ───────────────────────────
DEFAULT_MAX_CONNECTIONS=2
DEFAULT_MIN_LAYOVER_MINUTES=30
DEFAULT_MAX_LAYOVER_MINUTES=360
MAX_JOURNEYS_RETURNED=20
